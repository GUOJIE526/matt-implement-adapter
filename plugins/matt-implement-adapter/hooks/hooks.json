{
  "description": "Load the Codex host adapter for Matt's multi-ticket implement workflow.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/session_start.ps1')\"",
            "timeout": 5,
            "statusMessage": "Loading Matt implement adapter"
          }
        ]
      }
    ]
  }
}
